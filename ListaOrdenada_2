#include <iostream>
#include <string>
using namespace std;

template<class T>
struct asc
{
    bool operator()(T a, T b)
    {
        return a < b;
    }
};

template<class T>
struct des
{
    bool operator()(T a, T b)
    {
        return a > b;
    }
};

template<class T, class O, int N=10>
class CSortedList{
        int tam=N;
        int elem=0;
        T arr[N];

    public:
        bool find(T x, T *&p);
        bool add(T x);
        bool del(T x);
        void print();
};

template<class T, class O, int N>
bool CSortedList<T,O,N>::find(T x, T *&p)
{
    p = arr;
    while(p < arr + elem && O()(*p, x))
        p++;

    return (p < arr + elem) && !O()(*p, x) && !O()(x, *p);
}

template<class T, class O, int N>
bool CSortedList<T,O,N>::add(T x)
{
    if(elem >= tam)
        return false;

    T *p;
    find(x, p);
    
    for(T *q = arr + elem; q > p; q--)
        *q = *(q - 1);

    *p = x;
    elem++;
    return true;
}

template<class T, class O, int N>
bool CSortedList<T,O,N>::del(T x)
{
    T *p;
    if(!find(x, p))
        return false;

    for(T *q = p; q < arr + elem - 1; q++)
        *q = *(q + 1);

    elem--;
    return true;
}

template<class T, class O, int N>
void CSortedList<T,O,N>::print()
{
    for(int i = 0; i < elem; i++)
        cout << *(arr+i) << " ";
    cout << endl;
}

int main()
{
    CSortedList<int,asc<int>> l;
    CSortedList<string,des<string>> c;

    l.add(3);
    l.add(14);
    l.add(7);
    l.add(11);
    l.print(); 

    c.add("avion");
    c.add("casa");
    c.add("bota");
    c.print(); 
}
