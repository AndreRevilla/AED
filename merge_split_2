#include <iostream>
using namespace std;

struct divs {
    bool operator()(int a) {
        return !(a % 3);
    }
};

void swap(int* a, int* b) {
    int tmp;
    tmp = *a;
    *a = *b;
    *b = tmp;
}

template <class O>
struct util {

    void split(int* ini, int* fin) {
    O vf;

    int* pos = ini;

    for (int* i = ini; i < fin; i++) {

        if (vf(*i)) {

            int temp = *i;
            int* r = i;

            while (r > pos) {
                *r = *(r - 1);
                r--;
            }

            *pos = temp;
            pos++;
        }
    }
}

    void merge(int* ini, int* mid, int* fin) {
    int* p = ini;
    int* q = mid;

        while (q < fin) {
    
            if (p < mid) {
                int* r = p;
    
                while (r < q) {
                    if (*r > *q) {
                        int temp = *r;
                        *r = *q;
                        *q = temp;
                    }
    
                    r++;
                }
    
                p++;
            }
    
            q++;
        }
    }
};

void print(int* t, int tam) {
    for (int* r = t; r < t + tam; r++) {
        cout << *r << " ";
    }
    
    cout<<endl;
}

int main() {
    int A[] = { 1,2,5,7,30,3,5,11,23,25 };
    int tam = sizeof(A) / sizeof(A[0]);
    util<divs> u;
    
    print(A, tam);
    
    u.merge(A, A + tam / 2, A+tam);
    print(A, tam);
    
    u.split(A,A+tam);
    print(A, tam);
    
    return 0;
}
