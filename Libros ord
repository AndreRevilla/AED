#include <iostream>
using namespace std;

class Libro
{
public:
    string titulo;
    string autor;
    float precio;
    int calificacion;

    Libro(string t, string a, float p, int c): titulo(t), autor(a), precio(p), calificacion(c) {}

    bool operator==(const Libro& o) const
    {
        return titulo == o.titulo && autor == o.autor &&
               precio == o.precio && calificacion == o.calificacion;
    }

    friend ostream& operator<<(ostream& os, const Libro& l)
    {
        os << "[" << l.titulo << " | " << l.autor
           << " | $" << l.precio << " | " << l.calificacion << "★]";
        return os;
    }
};

struct TituloAsc
{
    bool operator()(Libro a, Libro b)
    {
        return a.titulo < b.titulo;
    }
};

struct AutorAsc
{
    bool operator()(Libro a, Libro b)
    {
        return a.autor < b.autor;
    }
};

struct PrecioAsc
{
    bool operator()(Libro a, Libro b)
    {
        return a.precio < b.precio;
    }
};

struct CalificacionAsc
{
    bool operator()(Libro a, Libro b)
    {
        return a.calificacion < b.calificacion;
    }
};

struct TituloDes
{
    bool operator()(Libro a, Libro b)
    {
        return a.titulo > b.titulo;
    }
};

struct AutorDes
{
    bool operator()(Libro a, Libro b)
    {
        return a.autor > b.autor;
    }
};

struct PrecioDes
{
    bool operator()(Libro a, Libro b)
    {
        return a.precio > b.precio;
    }
};

struct CalificacionDes
{
    bool operator()(Libro a, Libro b)
    {
        return a.calificacion > b.calificacion;
    }
};

template<class T>
struct asc
{
    bool operator()(T a, T b)
    {
        return a < b;
    }
};

template<class T>
struct des
{
    bool operator()(T a, T b)
    {
        return a > b;
    }
};

template<class T>
struct CNode
{
    T value;
    CNode<T>* next;

    CNode(T v) : value(v), next(0) {} 
};

template<class T, class O>
class CSortedList
{
public:
    CSortedList();
    ~CSortedList();

    bool find(T x, CNode<T>**& p);
    bool ins(T x);
    bool rem(T x);
    void print();

private:
    CNode<T>* head;
};

template<class T, class O>
CSortedList<T,O>::CSortedList()
{
    head = 0;
}

template<class T, class O>
CSortedList<T,O>::~CSortedList()
{
    CNode<T>* t;
    while(head) {
        t = head;
        head = head->next;
        delete t;
    }
}



template<class T, class O>
bool CSortedList<T,O>::find(T x, CNode<T>**& p)
{
    for (p = &head; *p && O()((*p)->value, x);
         p = &((*p)->next));

    return *p && (*p)->value == x;
}

template<class T, class O>
bool CSortedList<T,O>::ins(T x)
{
    CNode<T>** p;

    if(find(x, p))
        return false;

    CNode<T>* t = new CNode<T>(x);

    t->next = *p;
    *p = t;

    return true;
}

template<class T,class O>
bool CSortedList<T,O>::rem(T x)
{
    CNode<T>** p;

    if(!find(x, p))
        return false;

    CNode<T>* t = *p;
    *p = t->next;

    delete t;

    return true;
}

template<class T, class O>
void CSortedList<T,O>::print()
{
    for(CNode<T>* t = head; t; t = t->next)
        cout << t->value << "\n";

    cout << "\n";
}

int main()
{
    CSortedList<int,asc<int>> l;
    CSortedList<string,des<string>> c;
    CSortedList<Libro, PrecioDes> b;
    l.ins(3);
    l.ins(14);
    l.ins(7);
    l.ins(11);

    l.print();
    
    c.ins("avion");
    c.ins("casa");
    c.ins("bota");
    c.print();
    
    b.ins(Libro("el principito", "antoine", 70, 5));
    b.ins(Libro("foraneos", "botiquer", 30, 4));
    b.ins(Libro("gangsters", "benson", 40, 3));
    b.print();
    
}
