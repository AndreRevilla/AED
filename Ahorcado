#include <iostream>
#include <stdlib.h>
#include <ctime>  
using namespace std;

struct intento {
    int vidas;
    string palabra_adivinada;
    string letras_erroneas;

    intento(int v = 15, string p = "", string le = "");
};

intento::intento(int v, string p, string le) {
    vidas = v;
    palabra_adivinada = p;
    letras_erroneas = le;
}

template<class T, int N = 30>
struct estado {
    int n_elem;
    T* array;
    T* head;
    T* tail;
    T* final;
    
    estado();
    ~estado();
    bool lleno();
    bool vacio();
    bool push(T val);
    bool pop(T& val);

};

template<class T, int N>
estado<T, N>::estado() {
    n_elem = N;
    array = new T[n_elem];
    final = array + (n_elem - 1);
    head = NULL;
    tail = NULL;
}

template<class T, int N>
bool estado<T, N>::lleno() {
    return ((tail == final && head == array) || (head - 1 == tail));
}

template<class T, int N>
bool estado<T, N>::vacio() {
    if (head == nullptr && tail == nullptr)
        return true;
    else
        return false;
}

template<class T, int N>
bool estado<T, N>::push(T val) {
    if (lleno()) {
        tail++;
        head++;
        if (tail > final) {
            tail = array;
        }
        if (head > final) {
            head = array;
        }
    }

    else if (vacio()) {
        head = array;
        tail = array;
    }

    else {
        tail++;
    }

    *tail = val;
    return true;
}

template<class T, int N>
bool estado<T, N>::pop(T& val) {
    if (vacio()) {
        cout << "No hay estados a mostrar" << endl;
        return false;
    }
    val = *tail;
    if (head == tail) {
        head = nullptr;
        tail = nullptr;
    }
    else {
        tail--;
        if (tail < array)
            tail = final;
    }
    return true;
}

template<class T, int N>
estado<T, N>::~estado() {
    delete[] array;
}

void juego() {
    string palabras[] = {"banana", "computadora", "algoritmo", "estructura", "puntero"};
    int total_palabras = 5;

    srand(time(0));
    string palabra_secreta = palabras[rand() % total_palabras];

    estado<intento, 10> pila;
    intento actual(15, string(palabra_secreta.size(), '_'), "");

    while (actual.vidas > 0 && actual.palabra_adivinada != palabra_secreta) {
        cout << "Palabra  : " << actual.palabra_adivinada << endl;
        cout << "Vidas    : " << actual.vidas << endl;
        cout << "Errores  : " << actual.letras_erroneas << endl;
        cout << "Letra (* para Ctrl+Z): ";

        char entrada;
        cin >> entrada;

        if (entrada == '*') {
            pila.pop(actual);
            continue;
        }

        // Guardar estado actual ANTES del intento
        pila.push(actual);

        // Procesar letra
        bool acierto = false;
        for (int i = 0; i < palabra_secreta.size(); i++) {
            if (palabra_secreta[i] == entrada) {
                actual.palabra_adivinada[i] = entrada;
                acierto = true;
            }
        }

        if (!acierto) {
            actual.letras_erroneas += entrada;
            actual.vidas--;
            cout << "Incorrecto! -1 vida." << endl;
        } else {
            cout << "Correcto!" << endl;
        }
    }

    if (actual.palabra_adivinada == palabra_secreta)
        cout << "Ganaste! La palabra era: " << palabra_secreta << endl;
    else
        cout << "Perdiste. La palabra era: " << palabra_secreta << endl;
}

int main() {
    juego();

    return 0;
}
